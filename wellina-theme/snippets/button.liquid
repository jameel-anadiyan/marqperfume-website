{%- comment -%}
  Renders signature Wellina button with slideInOut text & optional solid right icon circle.
  Accepts:
  - label: {String}
  - href: {String}
  - style: 'icon-solid' | 'primary' | 'secondary' | 'white' | 'dark' | 'outline-light'
  - class: {String}
  - attrs: {String}
{%- endcomment -%}
{%- liquid
  assign btn_style = style | default: 'icon-solid'
  assign btn_tag = 'a'
  if href == blank
    assign btn_tag = 'button'
  endif
-%}
<{{ btn_tag }}
  {% if href != blank %}href="{{ href }}"{% else %}type="button"{% endif %}
  class="btn btn--{{ btn_style }}{% if class != blank %} {{ class }}{% endif %}"
  {{ attrs }}
>
  <span class="btn__text-wrap">
    <span class="btn__text" data-text="{{ label | escape }}">{{ label }}</span>
  </span>
  {%- if btn_style == 'icon-solid' -%}
    <span class="btn__icon-circle" aria-hidden="true">
      {% render 'icon', name: 'chevron-right' %}
    </span>
  {%- endif -%}
</{{ btn_tag }}>

