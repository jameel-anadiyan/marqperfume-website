          "vendor": {{ p.vendor | default: 'MARQ Perfumes' | json }},
          "type": {{ p.type | default: 'Eau de Parfum' | json }},
          "price": {{ p.price | default: 120000 }},
          "compare_at_price": {{ p.compare_at_price | default: 0 }},
          "available": {{ p.available | json }},
          "url": {{ p.url | json }},
          "description": {{ p.description | strip_html | truncate: 240 | json }},
          "featured_image": {{ p.featured_image | image_url: width: 900 | json }},
          "second_image": {% if p.images[1] != blank %}{{ p.images[1] | image_url: width: 900 | json }}{% else %}null{% endif %},
          "images": [{%- for img in p.images limit: 6 -%}{{ img | image_url: width: 900 | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}],
