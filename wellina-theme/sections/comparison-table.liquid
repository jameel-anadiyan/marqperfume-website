<section class="section-pad color-scheme-1">
  <div class="page-width">
    <div class="comparison-split">
      <div class="comparison-split__intro">
        <p class="text-subheading">MARQ VS. ORDINARY</p>
        <h2 class="h1">True Parfum.<br>No shortcuts.</h2>
        <p>See how MARQ 22% Eau de Parfum compares against conventional department-store Eau de Toilette and synthetic body mists.</p>
      </div>

      <div class="comparison-table-wrap">
        <table class="quick-comparison-table">
          <thead>
            <tr>
              <th></th>
              <th class="is-highlight">MARQ EDP</th>
              <th>Standard EDT</th>
              <th>Body Mists</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>22% fine perfume oil concentration</td>
              <td class="is-highlight"><span class="table-check">{% render 'icon', name: 'check' %}</span></td>
              <td><span class="table-cross">&mdash;</span></td>
              <td><span class="table-cross">&mdash;</span></td>
            </tr>
            <tr>
              <td>8–12+ hour skin longevity</td>
              <td class="is-highlight"><span class="table-check">{% render 'icon', name: 'check' %}</span></td>
              <td><span class="table-cross">&mdash;</span></td>
              <td><span class="table-cross">&mdash;</span></td>
            </tr>
            <tr>
              <td>Cold-pressed natural botanicals</td>
              <td class="is-highlight"><span class="table-check">{% render 'icon', name: 'check' %}</span></td>
              <td><span class="table-check">{% render 'icon', name: 'check' %}</span></td>
              <td><span class="table-cross">&mdash;</span></td>
            </tr>
            <tr>
              <td>Phthalate-free &amp; cruelty-free</td>
              <td class="is-highlight"><span class="table-check">{% render 'icon', name: 'check' %}</span></td>
              <td><span class="table-cross">&mdash;</span></td>
              <td><span class="table-check">{% render 'icon', name: 'check' %}</span></td>
            </tr>
            <tr>
              <td>UV-shielded sapphire glass flacon</td>
              <td class="is-highlight"><span class="table-check">{% render 'icon', name: 'check' %}</span></td>
              <td><span class="table-cross">&mdash;</span></td>
              <td><span class="table-cross">&mdash;</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

