{%- liquid
  assign u_poud_h = 'marq-passion-oud-hero.jpg' | asset_url
  assign u_poud_2 = 'marq-passion-oud.jpg' | asset_url
  assign u_cherry_h = 'marq-dark-cherry-hero.jpg' | asset_url
  assign u_cherry_2 = 'marq-dark-cherry.jpg' | asset_url
  assign u_cotton_h = 'marq-cotton-hero.jpg' | asset_url
  assign u_cotton_2 = 'marq-cotton.jpg' | asset_url
  assign u_frost_h = 'marq-frost-hero.jpg' | asset_url
  assign u_frost_2 = 'marq-frost-1.jpg' | asset_url
-%}
<section class="section-pad color-scheme-1" data-carousel>
  <div class="page-width">
    <div class="section-head-split">
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <div class="slider-arrows">
        <button type="button" class="circle-btn circle-btn--outline" data-carousel-prev aria-label="Previous">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" class="circle-btn circle-btn--outline" data-carousel-next aria-label="Next">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>

    <div class="product-carousel-track" data-carousel-track>
      {%- if collections['all'] != blank and collections['all'].products_count > 0 -%}
        {%- for prod in collections['all'].products limit: 6 -%}
          <div class="carousel-cell">
            {% render 'product-card', card_product: prod %}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-passion-oud', demo_title: 'Passion Oud', demo_category: 'Eau de Parfum', demo_family: 'Woody', demo_gender: 'Unisex', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_poud_h, demo_hover_image: u_poud_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-dark-cherry', demo_title: 'Dark Cherry', demo_category: 'Eau de Parfum', demo_family: 'Oriental', demo_gender: 'Unisex', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_cherry_h, demo_hover_image: u_cherry_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-cotton', demo_title: 'Cotton', demo_category: 'Eau de Parfum', demo_family: 'Florals', demo_gender: 'Women', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_cotton_h, demo_hover_image: u_cotton_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-frost', demo_title: 'Frost', demo_category: 'Eau de Parfum', demo_family: 'Fresh', demo_gender: 'Unisex', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_frost_h, demo_hover_image: u_frost_2 %}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related Fragrances",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover more fragrances"
    }
  ],
  "presets": [
    {
      "name": "Related Fragrances"
    }
  ]
}
{% endschema %}
