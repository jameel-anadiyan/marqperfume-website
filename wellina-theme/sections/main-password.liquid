<section class="password-section color-scheme-2">
  <div class="page-width page-width--narrow section-head-center">
    <img src="{{ 'marq-logo-white.png' | asset_url }}" alt="MARQ Perfumes" width="160" class="password-logo">
    <h1 class="display-title">A new standard of fine fragrance, <em>opening soon.</em></h1>
    <p class="section-subtext">{{ shop.password_message | default: 'Enter storefront password below to preview.' }}</p>

    {% form 'storefront_password', class: 'newsletter-form' %}
      <div class="newsletter-form__pill-group">
        <input type="password" name="password" placeholder="Enter password" class="newsletter-form__input" required>
        <button type="submit" class="btn btn--primary">
          <span class="btn__text-wrap"><span class="btn__text" data-text="Enter">Enter</span></span>
        </button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Main Password",
  "settings": []
}
{% endschema %}

