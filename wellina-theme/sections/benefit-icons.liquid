<section class="section-pad section-benefit-icons color-scheme-1">
  <div class="page-width">
    <div class="section-head-center">
      <h2 class="h1">{{ section.settings.heading }}</h2>
    </div>

    <div class="benefit-icons-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="benefit-icon-item" {{ block.shopify_attributes }}>
            <div class="benefit-icon-circle" style="color: #245284;">
              {%- if block.settings.icon_image != blank -%}
                <img src="{{ block.settings.icon_image | image_url: width: 160 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <svg width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true"><rect x="12" y="5" width="12" height="5" rx="1.5" stroke="#245284" stroke-width="2"/><path d="M15 10V13H21V10" stroke="#245284" stroke-width="2"/><rect x="9" y="13" width="18" height="18" rx="3" stroke="#245284" stroke-width="2"/><path d="M13 19H23M15 23H21" stroke="#245284" stroke-width="1.8" stroke-linecap="round"/></svg>
                  {%- when 2 -%}
                    <svg width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M18 6C18 6 10 14.5 10 21C10 25.4183 13.5817 29 18 29C22.4183 29 26 25.4183 26 21C26 14.5 18 6 18 6Z" stroke="#245284" stroke-width="2" stroke-linejoin="round"/><path d="M14.5 21.5C14.5 23.5 16 25 18 25" stroke="#245284" stroke-width="1.8" stroke-linecap="round"/></svg>
                  {%- when 3 -%}
                    <svg width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M6 16C9 13 13 13 16 16C19 19 23 19 26 16C28 14 30 14 31 15" stroke="#245284" stroke-width="2" stroke-linecap="round"/><path d="M6 22C9 19 13 19 16 22C19 25 23 25 26 22C28 20 30 20 31 21" stroke="#245284" stroke-width="2" stroke-linecap="round"/></svg>
                  {%- else -%}
                    <svg width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M18 7L20.8 14.2L28 17L20.8 19.8L18 27L15.2 19.8L8 17L15.2 14.2L18 7Z" stroke="#245284" stroke-width="2" stroke-linejoin="round"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </div>
            <h3 class="h3">{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefit Icons Strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The art of modern aquatic fragrance"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "12-Hour Longevity"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "High-concentration Eau de Parfum oils engineered to evolve gracefully from morning to midnight"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit Icons Strip",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "12-Hour Longevity",
            "text": "High-concentration Eau de Parfum oils engineered to evolve gracefully from morning to midnight"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Cold-Pressed Botanicals",
            "text": "Harvested bergamot, crisp lime zest, wild berries, and dewy white lily petals"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Oceanic Freshness",
            "text": "Signature ozonic marine molecules capture the invigorating rush of cool blue waters"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Clean Formulation",
            "text": "Vegan, cruelty-free fine fragrance crafted without phthalates, parabens, or harsh dyes"
          }
        }
      ]
    }
  ]
}
{% endschema %}
