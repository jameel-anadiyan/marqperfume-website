        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-midnight-spice', demo_title: 'Midnight Spice', demo_category: 'Eau de Parfum', demo_family: 'Oriental', demo_gender: 'Men', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_spice_h, demo_hover_image: u_spice_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-velvet-oud', demo_title: 'Velvet Oud', demo_category: 'Eau de Parfum', demo_family: 'Oriental', demo_gender: 'Unisex', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_voud_h, demo_hover_image: u_voud_2 %}</div>
