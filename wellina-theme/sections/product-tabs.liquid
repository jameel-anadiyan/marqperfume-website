<section
  class="section-pad section-product-tabs color-scheme-1{% if section.settings.overlap_hero %} section-overlap-top{% endif %}"
  data-product-tabs
>
  <div class="page-width">
    <div class="section-head-split">
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <div class="pill-tabs" role="tablist">
        <button type="button" class="pill-tab" role="tab" aria-selected="false" data-tab-trigger="bestsellers">
          Best Sellers
        </button>
        <button type="button" class="pill-tab is-active" role="tab" aria-selected="true" data-tab-trigger="perfumes">
          Eau de Parfum
        </button>
        <button type="button" class="pill-tab" role="tab" aria-selected="false" data-tab-trigger="attar">
          Attar &bull; Oil
        </button>
        <button type="button" class="pill-tab" role="tab" aria-selected="false" data-tab-trigger="bakhoor">
          Bakhoor &bull; Incense
        </button>
      </div>
    </div>

    <div class="tab-carousel-panel" data-tab-panel="bestsellers" data-carousel hidden>
      <div class="product-carousel-track" data-carousel-track>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-navy', demo_title: 'Navy', demo_category: 'Eau de Parfum', demo_family: 'Fresh', demo_gender: 'Men', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_navy_h, demo_hover_image: u_navy_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-passion-oud', demo_title: 'Passion Oud', demo_category: 'Eau de Parfum', demo_family: 'Woody', demo_gender: 'Unisex', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_poud_h, demo_hover_image: u_poud_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-velvet-oud-attar', demo_title: 'Velvet Oud Attar', demo_category: 'Attar', demo_family: 'Oriental', demo_gender: 'Unisex', demo_price: 25000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_at_voud_h, demo_hover_image: u_at_voud_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-royal-bakhoor', demo_title: 'Royal Bakhoor', demo_category: 'Bakhoor', demo_family: 'Oriental', demo_gender: 'Unisex', demo_price: 120000, demo_badge: 'New', demo_badge_type: 'new', demo_image: u_bk_r1, demo_hover_image: u_bk_r2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-dark-cherry', demo_title: 'Dark Cherry', demo_category: 'Eau de Parfum', demo_family: 'Oriental', demo_gender: 'Unisex', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_cherry_h, demo_hover_image: u_cherry_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-jasmine-attar', demo_title: 'Mogra Jasmine Attar', demo_category: 'Attar', demo_family: 'Florals', demo_gender: 'Unisex', demo_price: 25000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_at_jas_h, demo_hover_image: u_at_jas_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-oud-bakhoor', demo_title: 'Oud Bakhoor', demo_category: 'Bakhoor', demo_family: 'Oriental', demo_gender: 'Unisex', demo_price: 65000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_bk_o1, demo_hover_image: u_bk_o2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-cotton', demo_title: 'Cotton', demo_category: 'Eau de Parfum', demo_family: 'Florals', demo_gender: 'Women', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_cotton_h, demo_hover_image: u_cotton_2 %}</div>
      </div>

      <div class="carousel-footer-controls">
        <div class="slider-progress"><span data-carousel-progress style="width: 35%"></span></div>
        <div class="slider-arrows">
          <button type="button" class="circle-btn circle-btn--outline" data-carousel-prev aria-label="Previous products">{% render 'icon', name: 'chevron-left' %}</button>
          <button type="button" class="circle-btn circle-btn--outline" data-carousel-next aria-label="Next products">{% render 'icon', name: 'chevron-right' %}</button>
        </div>
      </div>
    </div>

