        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-stay-close', demo_title: 'Stay Close', demo_category: 'Eau de Parfum', demo_family: 'Woody', demo_gender: 'Men', demo_price: 120000, demo_badge: 'New', demo_badge_type: 'new', demo_image: u_stay_h, demo_hover_image: u_stay_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-red-apple', demo_title: 'Red Apple', demo_category: 'Eau de Parfum', demo_family: 'Oriental', demo_gender: 'Men', demo_price: 120000, demo_image: u_apple_h, demo_hover_image: u_apple_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-ocean-breeze', demo_title: 'Ocean Breeze', demo_category: 'Eau de Parfum', demo_family: 'Fresh', demo_gender: 'Unisex', demo_price: 120000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_ocean_h, demo_hover_image: u_ocean_2 %}</div>
      </div>

      <div class="carousel-footer-controls">
        <div class="slider-progress"><span data-carousel-progress style="width: 35%"></span></div>
        <div class="slider-arrows">
          <button type="button" class="circle-btn circle-btn--outline" data-carousel-prev aria-label="Previous products">{% render 'icon', name: 'chevron-left' %}</button>
          <button type="button" class="circle-btn circle-btn--outline" data-carousel-next aria-label="Next products">{% render 'icon', name: 'chevron-right' %}</button>
        </div>
      </div>
    </div>

    <div class="tab-carousel-panel" data-tab-panel="attar" data-carousel hidden>
      <div class="product-carousel-track" data-carousel-track>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-jasmine-attar', demo_title: 'Mogra Jasmine Attar', demo_category: 'Attar', demo_family: 'Florals', demo_gender: 'Unisex', demo_price: 25000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_at_jas_h, demo_hover_image: u_at_jas_2 %}</div>
        <div class="carousel-cell">{% render 'product-card', demo_handle: 'marq-velvet-oud-attar', demo_title: 'Velvet Oud Attar', demo_category: 'Attar', demo_family: 'Oriental', demo_gender: 'Unisex', demo_price: 25000, demo_badge: 'Best Sellers', demo_badge_type: 'bestseller', demo_image: u_at_voud_h, demo_hover_image: u_at_voud_2 %}</div>
