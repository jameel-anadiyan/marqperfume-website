{% schema %}
{
  "name": "Product Tabs Carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "overlap_hero",
      "label": "Overlap rounded top over Hero section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your signature scent"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "First tab label",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Second tab label",
      "default": "Eau de Parfum"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "First tab collection"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Second tab collection"
    }
  ],
  "presets": [
    {
      "name": "Product Tabs Carousel"
    }
  ]
}
{% endschema %}
