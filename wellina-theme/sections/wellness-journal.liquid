<section class="section-pad color-scheme-1">
  <div class="page-width">
    <div class="section-head-center">
      <h2 class="h1">{{ section.settings.heading }}</h2>
    </div>

    {%- assign journal = blogs[section.settings.blog] -%}
    <div class="journal-grid">
      {%- if journal != blank and journal.articles_count > 0 -%}
        {%- for article in journal.articles limit: 3 -%}
          <article class="journal-card">
            <a href="{{ article.url }}" class="journal-card__media">
              {%- if article.image != blank -%}
                <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'marq-slider-1.jpg' | asset_url }}" alt="{{ article.title | escape }}" loading="lazy">
              {%- endif -%}
              {%- if article.tags.size > 0 -%}
                <span class="journal-card__tag">{{ article.tags.first }}</span>
              {%- endif -%}
            </a>
            <h3 class="h4"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="journal-card__meta">{{ article.published_at | date: '%b %d, %Y' }} &bull; {{ article.author }}</p>
          </article>
        {%- endfor -%}
      {%- else -%}
        <article class="journal-card">
          <a href="/blogs/news" class="journal-card__media">
            <img src="{{ 'marq-slider-1.jpg' | asset_url }}" alt="Inside Navy: Citrus, Lavender & Sandalwood" loading="lazy">
            <span class="journal-card__tag">Perfumery</span>
          </a>
          <h3 class="h4"><a href="/blogs/news">Inside Navy: Citrus Zest, Lavender &amp; Sandalwood</a></h3>
          <p class="journal-card__meta">Nov 12, 2026 &bull; MARQ Atelier</p>
        </article>

        <article class="journal-card">
          <a href="/blogs/news" class="journal-card__media">
            <img src="{{ 'marq-slider-2.jpg' | asset_url }}" alt="The Craft of Modern Marine Accords" loading="lazy">
            <span class="journal-card__tag">Ingredients</span>
          </a>
          <h3 class="h4"><a href="/blogs/news">The Craft of Modern Marine &amp; Coastal Accords</a></h3>
          <p class="journal-card__meta">Nov 08, 2026 &bull; MARQ Atelier</p>
        </article>

        <article class="journal-card">
          <a href="/blogs/news" class="journal-card__media">
            <img src="{{ 'marq-slider-3.jpg' | asset_url }}" alt="How to Layer Eau de Parfum for All-Day Sillage" loading="lazy">
            <span class="journal-card__tag">Rituals</span>
          </a>
          <h3 class="h4"><a href="/blogs/news">How to Layer Eau de Parfum for 12-Hour Sillage</a></h3>
          <p class="journal-card__meta">Nov 02, 2026 &bull; MARQ Atelier</p>
        </article>
      {%- endif -%}
    </div>

    <div class="section-foot-center">
      {% render 'button', label: 'Read the Journal', href: '/blogs/news', style: 'icon-solid' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fragrance Journal",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Fragrance Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "Fragrance Journal"
    }
  ]
}
{% endschema %}
