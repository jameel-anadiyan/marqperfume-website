<section class="section-pad color-scheme-1" data-press-slider>
  <div class="page-width page-width--press">
    <div class="press-top-row">
      <div class="press-top-row__label">
        <p class="text-subheading">ACCLAIMED BY<br>FRAGRANCE EDITORS</p>
      </div>

      <div class="press-top-row__quotes">
        <blockquote class="h2 press-quote is-active" data-press-quote="0">
          &ldquo;An exhilarating rush of chilled citrus, lavender, and warm sandalwood&mdash;Navy redefines modern coastal perfumery.&rdquo;
        </blockquote>
        <blockquote class="h2 press-quote" data-press-quote="1">
          &ldquo;Rarely does a fresh marine scent achieve this level of luminous depth and twelve-hour skin longevity.&rdquo;
        </blockquote>
        <blockquote class="h2 press-quote" data-press-quote="2">
          &ldquo;From its architectural fluted sapphire bottle to its dewy white lily dry-down, MARQ is pure coastal luxury.&rdquo;
        </blockquote>
        <blockquote class="h2 press-quote" data-press-quote="3">
          &ldquo;Crisp, effortless, and unmistakably refined&mdash;the ultimate signature Eau de Parfum for modern minimalists.&rdquo;
        </blockquote>
      </div>
    </div>

    <div class="press-logos" role="tablist" aria-label="Press publications">
      <button type="button" class="press-logo-btn is-active" data-press-btn="0" aria-label="Refinery29">
        <img src="https://pebble-wellina.myshopify.com/cdn/shop/files/press-1.webp?width=320" alt="Refinery29" loading="lazy">
      </button>
      <button type="button" class="press-logo-btn" data-press-btn="1" aria-label="InStyle">
        <img src="https://pebble-wellina.myshopify.com/cdn/shop/files/press-2.webp?width=320" alt="InStyle" loading="lazy">
      </button>
      <button type="button" class="press-logo-btn" data-press-btn="2" aria-label="Interior Design">
        <img src="https://pebble-wellina.myshopify.com/cdn/shop/files/press-3.webp?width=320" alt="Interior Design" loading="lazy">
      </button>
      <button type="button" class="press-logo-btn" data-press-btn="3" aria-label="ELLE">
        <img src="https://pebble-wellina.myshopify.com/cdn/shop/files/press-4.webp?width=320" alt="ELLE" loading="lazy">
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Press Quotes",
  "settings": [],
  "presets": [
    {
      "name": "Press Quotes"
    }
  ]
}
{% endschema %}
